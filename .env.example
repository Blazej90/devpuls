# Claude API — ocena trafności + streszczenia PL
ANTHROPIC_API_KEY=

# Neon (Postgres) — connection string z pooler URL
DATABASE_URL=

# Web Push (VAPID) — wygenerowane raz: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:blazejbart@gmail.com

# Opcjonalne — strojenie pipeline'u
# Próg trafności (1-5), od którego lecą powiadomienia
RELEVANCE_THRESHOLD=4
# Ile wpisów maksymalnie bierzemy z jednego źródła na przebieg
MAX_ITEMS_PER_SOURCE=15
