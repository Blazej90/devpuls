# Zmienne aplikacji webowej (apps/web). Kopiuj do .env.local.
#
# Uwaga: to osobny plik od `.env` w roocie repo. Root `.env` obsługuje agenta
# (GitHub Actions), ten plik — Next.js (Vercel). Ten sam podział obowiązuje na
# produkcji: sekrety agenta w GitHub Actions, sekrety weba w env Vercela.

# Klucz publiczny VAPID — trafia do przeglądarki, musi być identyczny
# z VAPID_PUBLIC_KEY w roocie repo. Wygenerowane raz przez web-push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Neon — ten sam connection string co w roocie. Używany przez
# app/api/push/subscribe do zapisu subskrypcji.
DATABASE_URL=
